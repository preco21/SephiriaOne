<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sephiria</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../SephiriaOne/Localization/*.cs" Link="Production/%(Filename)%(Extension)" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <EmbeddedResource Include="Fixtures/en.json" LogicalName="SephiriaOne.Localization.en.json" />
    <EmbeddedResource Include="Fixtures/ko.json" LogicalName="SephiriaOne.Localization.ko.json" />
  </ItemGroup>
</Project>
